---
/**
 * O trecho do conto como folha de papel, e não como legenda sobreposta.
 *
 * No Conceito o conto vive por cima da imagem, num gradiente. No Mood, na
 * Persona e no Trendboard ele é peça da composição: uma folha pregada na parede
 * entre as fotos, e o primeiro painel do lineup. Reproduz a página original do
 * book — capitular grande na cor da seção, com a estrela atrás dela — em texto
 * de verdade, em vez de embarcar o 16.png de cada zip, que é essa mesma página
 * rasterizada.
 *
 * A inicial é um <span> de verdade, não o `.capitular::first-letter` global,
 * porque a estrela se posiciona em relação a ela e só um elemento posicionado
 * serve de referência. Com ::first-letter a estrela precisaria de medida
 * chutada em px, e desalinharia assim que o corpo do texto mudasse de tamanho —
 * a capitular escala em em, a estrela não. Aqui as duas saem do mesmo em.
 */
import Estrela from "./Estrela.astro";

interface Props {
  paragrafos: string[];
  /** Cor da capitular. Na página original é a cor da seção. */
  corCapitular?: string;
  /** Cor da estrela atrás da capitular. */
  corEstrela?: string;
  /** Tamanho da estrela, em múltiplos do corpo da inicial. */
  estrelaTamanho?: string;
  /** Deslocamento da estrela em relação à letra, em % do tamanho da estrela. */
  estrelaX?: string;
  estrelaY?: string;
  /** Número de pontas da estrela. */
  estrelaPontas?: number;
  /**
   * Escala do aparato da folha: o recuo, a capitular e a estrela — tudo que
   * está em `em` do corpo da folha. O texto fica de fora, porque tem tamanho
   * próprio. É o que faz a folha caber numa coluna estreita sem que a
   * decoração coma a largura do texto (ver Mural.astro).
   */
  escala?: number;
  class?: string;
}

const {
  paragrafos,
  corCapitular = "var(--cor-resistencia)",
  corEstrela = "var(--cor-ninho)",
  estrelaTamanho = "2.2em",
  estrelaX = "-12%",
  estrelaY = "-15%",
  estrelaPontas = 8,
  escala = 1,
  class: className,
} = Astro.props;

const [abertura = "", ...demais] = paragrafos;
const inicial = abertura.slice(0, 1);
const continuacao = abertura.slice(1);
---

<div
  class:list={["folha-conto papel font-conto", className]}
  data-folha-conto
  style={`--cor-capitular:${corCapitular}; --cor-estrela:${corEstrela}; --estrela-tamanho:${estrelaTamanho}; --estrela-x:${estrelaX}; --estrela-y:${estrelaY}; --esc-folha:${escala}`}
>
  {
    abertura && (
      <p class="abertura"><span class="inicial"><Estrela pontas={estrelaPontas} brilho tamanho={100} cor="var(--cor-estrela)" class="estrela-conto" /><span class="letra">{inicial}</span></span>{continuacao}</p>
    )
  }
  {demais.map((p) => <p>{p}</p>)}
</div>

<style>
  /* O recuo de cima e da esquerda é bem maior que os outros dois de propósito:
     é ele que abriga a estrela, que é maior que a letra e ainda por cima está
     deslocada para o canto superior esquerdo. Regra: o recuo precisa cobrir
     (metade da estrela + deslocamento − metade da letra).

     O `overflow: hidden` de .na-parede não está aqui para cortar nada — com o
     recuo acima a estrela cabe inteira na folha. Ele existe porque no mural a
     folha vive dentro de um container multicoluna, e ali o Chrome não pinta a
     estrela (posicionada de forma absoluta) no fragmento certo: ela sumia da
     letra e reaparecia no topo da parede. O contexto de formatação novo que o
     overflow cria conserta a pintura. Medido: sem ele, zero pixel de estrela na
     folha do Mood e da Persona; com ele, a estrela aparece igual à do
     Trendboard, que nunca teve o problema por não estar em multicoluna. */
  /* O corpo da folha é a régua de todo o aparato — recuo, capitular e estrela
     saem daqui, e só o texto tem tamanho próprio. Duas coisas o encolhem:

     - o `--esc-folha` de quem chama, para a folha caber numa coluna estreita.
       Na parede do Mood e da Persona a coluna tem ~19rem, e com o aparato em
       tamanho cheio sobravam 13rem de texto — umas trinta e poucas letras por
       linha. No lineup do Trendboard, onde a folha tem 26rem, a escala é 1.
     - o clamp de viewport, que cuida do celular: a coluna lá é a tela inteira,
       mas um recuo de 4,5rem nela é quase um terço da largura. */
  .folha-conto {
    position: relative;
    isolation: isolate;
    color: var(--cor-resistencia);
    font-size: calc(var(--esc-folha, 1) * clamp(0.7rem, 1.6vw, 1rem));
    padding: 4.3em 2em 2.2em 4.5em;
  }

  .folha-conto.na-parede {
    overflow: hidden;
  }

  /* Tamanho fixo, não fluido por viewport: a largura da folha não cresce com
     a tela — na parede ela é a coluna do mural, que é fixa, e no lineup é
     min(26rem, 80vw). Texto que crescesse com a viewport só espremeria a
     medida numa caixa que ficou do mesmo tamanho.

     A hifenização é o que salva a medida curta da parede: com ~40 letras por
     linha, sem ela o rio da direita fica com buracos de meia palavra. Só
     funciona com o `lang` da página declarado, e o BaseLayout declara pt-BR. */
  .folha-conto p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.7;
    text-wrap: pretty;
    hyphens: auto;
  }

  .folha-conto p + p {
    margin-top: 1.1em;
  }

  /* Margem, não padding: o afastamento do texto fica fora da caixa, então o
     50% da estrela resolve contra a letra e não contra letra-mais-respiro. */
  .inicial {
    position: relative;
    float: left;
    margin-right: 0.08em;
    font-family: var(--font-display);
    font-size: 4.5em;
    line-height: 0.85;
    color: var(--cor-capitular);
  }

  .letra {
    position: relative;
    z-index: 1;
  }

  /* Deslocada na diagonal para cima e para a esquerda da letra, como na página
     original do book: a inicial não fica no meio da estrela, fica no quadrante
     inferior direito dela. O deslocamento é em % do próprio tamanho da estrela,
     então acompanha qualquer mudança de escala.

     Sai do fluxo, então não empurra o texto; o aria-hidden vem do componente
     Estrela. */
  .estrela-conto {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: var(--estrela-tamanho);
    height: var(--estrela-tamanho);
    translate: calc(-50% + var(--estrela-x)) calc(-50% + var(--estrela-y));
    opacity: 0.55;
    animation: cintilar var(--dur-ambiente, 7s) ease-in-out infinite alternate;
  }

  /* O respiro da estrela usa `rotate` e `scale` como propriedades próprias, não
     `transform`: assim compõem com o `translate` do deslocamento em vez de
     sobrescrevê-lo. A escala nunca passa de 1 porque no mural a folha recorta o
     que transborda: a escala fica sempre abaixo de 1 para a estrela nunca
     passar do tamanho que o layout reservou para ela. */
  @keyframes cintilar {
    from {
      rotate: -3deg;
      scale: 0.92;
      opacity: 0.42;
    }
    to {
      rotate: 3deg;
      scale: 0.98;
      opacity: 0.62;
    }
  }

  /* Bloco próprio, obrigatório: o kill-switch global de tokens.css só zera a
     duração, o que deixaria este loop `alternate` parado no estado final. */
  @media (prefers-reduced-motion: reduce) {
    .estrela-conto {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, mm, COM_MOVIMENTO, dur, curva, prioridade } from "../lib/motion";

  mm.add(COM_MOVIMENTO, () => {
    for (const folha of gsap.utils.toArray<HTMLElement>("[data-folha-conto]")) {
      const paragrafos = folha.querySelectorAll("p");
      if (!paragrafos.length) continue;

      // O conto se escreve: os parágrafos sobem um atrás do outro quando a
      // folha entra. O estado inicial nasce aqui dentro, nunca no CSS — fora do
      // matchMedia o texto jamais fica escondido, e o revert limpa isto sozinho
      // se a preferência mudar com a página aberta.
      //
      // O alvo é o <p>, que não tem transform nenhum do CSS. A estrela fica de
      // fora de propósito: ela já usa translate, rotate e scale por conta
      // própria, e um transform do GSAP por cima brigaria com os três.
      gsap.from(paragrafos, {
        opacity: 0,
        y: 14,
        duration: dur.media,
        ease: curva.fio,
        stagger: 0.16,
        clearProps: "transform,opacity",
        scrollTrigger: {
          trigger: folha,
          start: "top 86%",
          once: true,
          // A folha do conto só existe dentro do PainelTrendboard.
          refreshPriority: prioridade.trendboard,
        },
      });
    }
  });
</script>
