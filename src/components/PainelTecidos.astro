---
/**
 * Painel de tecidos e aviamentos: a materioteca da coleção.
 *
 * O índice de uma biblioteca de materiais: a lista de fichas corre de um lado
 * e a amostra da vez fica grande e parada do outro, trocando conforme a
 * leitura anda. É o arranjo que dá tamanho ao tecido — numa grade de
 * miniaturas não dá para ver a trama, que é justamente o que uma amostra tem
 * a dizer.
 *
 * A matéria vem de src/data/tecidos.ts e os recortes de
 * scripts/extract-tecidos.mjs, que tira o fundo das fotos de amostra e
 * descarta a legenda que vinha assada no PNG de cada aviamento — ali era
 * pixel, aqui é texto.
 *
 * Duas camadas, como no PainelTrendboard e na CaixaFotos:
 *
 * - A de baixo, que sempre funciona (sem JS, movimento reduzido, celular): uma
 *   lista comum, com a amostra ao lado da própria ficha. Nada depende de
 *   script para ser lido.
 * - A de cima é a classe `.armada`, que entra e sai **dentro** do `mm.add`.
 *   Ela troca as miniaturas pelo palco fixo. Se o matchMedia reverter e a
 *   classe ficar, a seção vira uma lista sem nenhuma imagem — por isso a
 *   classe sai no cleanup.
 */
import { Image } from "astro:assets";
import PranchaAviamentos from "./PranchaAviamentos.astro";
import { tecidos } from "../data/tecidos";
import { amostra } from "../lib/materiais";

const catalogo = tecidos;
---

<figure class="painel-tecidos relative left-1/2 right-1/2 -mx-[50vw] w-screen">
  <header>
    <h2 class="titulo-painel">Tecidos e aviamentos</h2>
  </header>

  <div class="materioteca" data-materioteca>
    {/* Camada 2: só aparece com a classe `.armada`. As imagens repetem as da
        lista, e por isso não têm texto alternativo próprio. */}
    <div class="palco" aria-hidden="true">
      <div class="moldura">
        {
          catalogo.map((t) => (
            <div class="grande" data-grande>
              <Image
                src={amostra(t.nome)}
                alt=""
                widths={[400, 640, 900]}
                sizes="(min-width: 900px) 42vw, 90vw"
                format="webp"
                quality={88}
              />
            </div>
          ))
        }
      </div>
    </div>

    <ol class="entradas">
      {
        catalogo.map((t) => (
          <li class="entrada" data-entrada style={`--tom:${t.tom}`}>
            <div class="mini">
              <Image
                src={amostra(t.nome)}
                alt={t.alt}
                widths={[400, 640, 900]}
                sizes="(min-width: 900px) 42vw, 90vw"
                format="webp"
                quality={88}
              />
            </div>
            <div class="texto">
              <h3 class="subtitulo-painel">{t.titulo}</h3>
              <dl>
                <dt class="sr-only">Composição</dt>
                <dd>{t.composicao}</dd>
                <dt class="sr-only">Gramatura</dt>
                <dd>{t.gramatura}</dd>
                <dt class="sr-only">Fornecedor</dt>
                <dd class="fonte">{t.fornecedor}</dd>
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <PranchaAviamentos />

  <figcaption class="sr-only">
    Materioteca da coleção: as dez amostras de tecido em tamanho grande, uma de cada vez, com
    composição, gramatura e fornecedor, seguidas da prancha dos catorze aviamentos, em que cada
    peça mostra o próprio nome ao ser aberta.
  </figcaption>
</figure>

<style>
  /* Em cima, o respiro comum dos títulos de painel; dos lados, a margem comum. O
     espaço entre o título e a primeira amostra é o do próprio `.titulo-painel`. */
  .painel-tecidos {
    padding: var(--titulo-topo) var(--margem-painel) clamp(2rem, 4vw, 3.5rem);
  }

  /* ── camada 1: lista comum ─────────────────────────────────────────────── */

  .palco {
    display: none;
  }

  .entradas {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entrada {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 560px) {
    .entrada {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .mini :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* A ficha é o que se lê enquanto a amostra é olhada: o nome no segundo nível de
     título (`.subtitulo-painel`, nunca maior que o título do painel), e a
     composição em corpo de leitura, não de legenda. */
  .texto h3 {
    margin: 0 0 0.7rem;
    padding-bottom: 0.55rem;
    border-bottom: 3px solid var(--tom);
  }

  dl {
    margin: 0;
  }

  dd {
    margin: 0;
    font-size: clamp(1.05rem, 1.3vw, 1.35rem);
    line-height: 1.55;
    opacity: 0.8;
  }

  .fonte {
    font-style: italic;
    opacity: 0.55;
  }

  /* ── camada 2: palco fixo, posta e retirada pelo matchMedia ────────────── */

  /* A amostra tem ~45% da altura da tela e a ficha encosta nela, na coluna dos
     títulos (antes: ~870px de amostra em 2560 e ~450px de vazio até a ficha). */
  .materioteca.armada {
    display: grid;
    width: min(100%, var(--coluna-painel));
    margin-inline: auto;
    grid-template-columns: min(45svh, 55%) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }

  /* O palco gruda exatamente onde ele mora quando a seção chega pela âncora do
     sumário (6rem da barra mais o bloco do título): assim, na entrada, a amostra
     fica à distância comum do título, e daí em diante fica parada nessa altura
     enquanto as fichas passam. Um `top` fixo em svh empurraria a amostra para
     baixo logo na entrada, porque o sticky também puxa para baixo o que mora
     acima da linha dele. */
  .armada .palco {
    /* A camada de baixo esconde o palco (`display: none`); é aqui que ele volta. */
    display: block;
    position: sticky;
    top: calc(
      6rem + var(--titulo-topo) + 1.04 * var(--titulo-tamanho) + var(--titulo-ate-conteudo)
    );
  }

  .armada .moldura {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .armada .grande {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .armada .grande :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 1rem 2rem rgb(0 0 0 / 0.35));
  }

  .armada .mini {
    display: none;
  }

  .armada .entradas {
    gap: 0;
  }

  /* Cada entrada ocupa meia tela: o tempo de a amostra ser olhada antes da
     próxima entrar, com a seção em ~5 telas (eram ~8,5 com uma tela por
     entrada). As entradas se encostam: exatamente uma cruza a linha de leitura
     de cada vez. */
  .armada .entrada {
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* A camada de baixo centra a ficha (`align-items: center`, pensado para a
       grade); aqui ela encosta à esquerda, junto da amostra, e todas as fichas
       começam no mesmo x. */
    align-items: flex-start;
    min-height: 50svh;
    padding-block: 1.5rem;
  }

  .armada .entrada .texto {
    max-width: 32rem;
    transition: opacity var(--dur-rapida) var(--curva-agulha);
  }

  /* Com meia tela por entrada, duas fichas aparecem juntas: a da amostra acesa
     fica inteira e as outras recuam. Quem põe o atributo é o script, dentro do
     mm.add; sem ele (sem JS, movimento reduzido, tela estreita) todas ficam
     iguais. Não é alvo de GSAP, então a transição de CSS aqui é segura. */
  .armada .entrada:not([data-entrada-acesa]) .texto {
    opacity: 0.45;
  }

  /* Os aviamentos moram em PranchaAviamentos.astro. */
</style>

<script>
  import { gsap, mm, COM_MOVIMENTO, dur, curva } from "../lib/motion";
  import { fichaMaisPerto } from "../lib/materioteca";

  // Camada 2: o palco fixo. A entrada que estiver no meio da tela manda na
  // amostra grande. Só em tela larga e só para quem não pediu menos movimento;
  // o cleanup devolve a lista da camada 1, senão a seção ficaria sem nenhuma
  // imagem.
  mm.add(`${COM_MOVIMENTO} and (min-width: 900px)`, () => {
    const caixa = document.querySelector<HTMLElement>("[data-materioteca]");
    const entradas = gsap.utils.toArray<HTMLElement>("[data-entrada]");
    const grandes = gsap.utils.toArray<HTMLElement>("[data-grande]");
    if (!caixa || entradas.length === 0) return;

    caixa.classList.add("armada");
    gsap.set(grandes, { opacity: 0 });
    gsap.set(grandes[0], { opacity: 1 });
    entradas[0].setAttribute("data-entrada-acesa", "");

    let atual = 0;

    // Um tween só, sobre a pilha inteira, e com `overwrite`. Dois tweens (um
    // apagando a anterior, outro acendendo a nova) parecem mais naturais e são
    // um bug: numa rolagem rápida o apagar de uma amostra termina antes do
    // acender que já estava em curso na mesma peça, e ela volta para 1 e fica
    // ligada. Dava denim na tela com a ficha do couro sintético.
    const mostrar = (i: number) => {
      if (i === atual) return;
      entradas[atual].removeAttribute("data-entrada-acesa");
      entradas[i].setAttribute("data-entrada-acesa", "");
      atual = i;
      gsap.to(grandes, {
        opacity: (k: number) => (k === i ? 1 : 0),
        duration: dur.rapida,
        ease: curva.agulha,
        overwrite: true,
      });
    };

    // Quem manda na amostra grande é um IntersectionObserver, não um
    // ScrollTrigger por entrada — e isso é deliberado. O ScrollTrigger mede uma
    // vez e remede na ordem de criação, que é a ordem do bundle e não a do
    // HTML: como esta seção é a última da página e duas seções acima dela pinam
    // (Trendboard e Caixa de Fotos), as entradas eram medidas **antes** de os
    // `pin-spacer` daquelas abrirem, e nasciam uns 5.000px adiantadas — a
    // amostra grande mostrava o denim enquanto a ficha ao lado dizia couro
    // sintético. Nem um refresh depois conserta (remede na mesma ordem), e
    // `refreshPriority` só mudou o erro de lugar. O IO não guarda medida
    // nenhuma: o navegador recalcula a interseção a cada quadro, e a Lenis move
    // o scroll real do documento, então ele funciona aqui como já funciona no
    // MenuConstelação.
    //
    // A margem esmaga a raiz numa linha só, na altura do centro da amostra
    // grudada (o `top` do palco mais meia moldura). Como as entradas se
    // encostam, exatamente uma cruza essa linha de cada vez.
    //
    // O aviso do observador é só o gatilho; quem decide é `fichaMaisPerto`,
    // medida na hora. Depois de um salto a linha pode cair fora de todas as
    // fichas (no vão até os aviamentos, por exemplo) e nenhuma avisa que entrou:
    // a amostra ficava presa na anterior, a sarja ao lado da ficha do denim. A
    // ficha mais perto da linha resolve as duas pontas.
    const palco = caixa.querySelector<HTMLElement>(".palco");
    const moldura = caixa.querySelector<HTMLElement>(".moldura");
    const linhaEmPx =
      parseFloat(palco ? getComputedStyle(palco).top : "0") + (moldura?.offsetHeight ?? 0) / 2;
    const linhaEmPorcento = Math.min(95, Math.max(5, (linhaEmPx / innerHeight) * 100));

    const acenderMaisPerto = () =>
      mostrar(
        fichaMaisPerto(
          entradas.map((entrada) => entrada.getBoundingClientRect()),
          (innerHeight * linhaEmPorcento) / 100,
        ),
      );

    const olho = new IntersectionObserver(acenderMaisPerto, {
      rootMargin: `-${linhaEmPorcento}% 0px -${100 - linhaEmPorcento}% 0px`,
      threshold: 0,
    });
    entradas.forEach((entrada) => olho.observe(entrada));

    // A segunda rede: um salto que vem de fora da seção e cai abaixo da lista
    // não cruza ficha nenhuma na linha, mas traz a materioteca para dentro da
    // tela. Quando ela entra (ou sai), escolhe-se de novo.
    const vigia = new IntersectionObserver(acenderMaisPerto, { threshold: 0 });
    vigia.observe(caixa);

    // A terceira: um salto que leva a linha de cima de todas as fichas para
    // baixo de todas, com a materioteca na tela antes e depois (barra de
    // rolagem arrastada depressa, `End`), não cruza ficha nem muda a interseção
    // da materioteca, e nenhum dos dois observadores avisa: ficava a Alicia ao
    // lado da ficha do Denim. O `scrollend` vem uma vez por rolagem, não a cada
    // quadro, e a escolha é pela medida da hora, então chamar a mais é inócuo.
    window.addEventListener("scrollend", acenderMaisPerto);
    acenderMaisPerto();

    // Quem tira a amostra de cena no fim da seção é o próprio sticky, não um
    // segundo observador. O palco é grudado dentro da grade das fichas e
    // desgruda com ela, então nunca alcança os aviamentos. Houve aqui um IO que
    // apagava o palco quando os aviamentos chegavam, e ele engolia a última
    // amostra: apagava com a ficha do Denim ainda inteira no meio da tela, uns
    // 360px antes de ela sair por cima. Na ordem natural a ficha sai primeiro e
    // a amostra logo atrás.

    return () => {
      olho.disconnect();
      vigia.disconnect();
      window.removeEventListener("scrollend", acenderMaisPerto);
      entradas.forEach((entrada) => entrada.removeAttribute("data-entrada-acesa"));
      caixa.classList.remove("armada");
    };
  });
</script>
